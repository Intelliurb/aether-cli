#!/usr/bin/expect -f
#
# Testes do loop interativo (raw mode / VT100), que os testes Catch2 não cobrem:
# eles testam funções puras, não o TTY. Aqui um PTY real é usado para digitar
# no shell e conferir o que ele repinta.
#
# Uso: expect tests/test_interactive.exp [caminho/para/aethercli]

set BIN [expr {$argc > 0 ? [lindex $argv 0] : "build/aethercli"}]
set BIN [file normalize $BIN]
# Generoso de propósito: cada login roda PBKDF2 de 600k iterações (~0,9s em
# Release, ~8s sob ENABLE_ASAN + -O0). O timeout precisa caber no build lento.
set timeout 25

# HOME próprio: isola history e ~/.aethercli/config.json (que teria precedência
# sobre o -C e quebraria o teste na máquina de quem tem um config de usuário).
set SANDBOX "/tmp/aethercli-exptest-[pid]"
file mkdir $SANDBOX
set env(HOME) $SANDBOX
set env(TERM) "dumb"
unset -nocomplain env(AETHERCLI_PEPPER)

set CONF "$SANDBOX/config.json"
set f [open $CONF w]
puts $f {{
  "motd": "TEST-MOTD-OK",
  "commands": [
    { "name": "show", "abbrev": "sh", "short_desc": "Exibir infos",
      "subcommands": [
        { "name": "version", "short_desc": "Versao", "activation": "echo VERSION_RAN", "syntax": "show version" },
        { "name": "files", "short_desc": "Arquivos", "activation": "echo FILES_RAN", "syntax": "show files [path]", "args": "append" }
      ] },
    { "name": "set", "short_desc": "Definir" },
    { "name": "run", "short_desc": "Executar" },
    { "name": "rm", "short_desc": "Remover" },
    { "name": "longtask", "short_desc": "Long task", "activation": "sleep 10" },
    { "name": "service", "short_desc": "Service control",
      "activation": "echo SERVICE_OK",
      "params": [
        { "name": "target", "type": "string", "description": "Target service", "required": true, "enum": ["nginx", "redis"] }
      ]
    },
    { "name": "readtty", "short_desc": "Le o terminal", "activation": "echo READY_TO_READ; read x; echo GOT=$x", "timeout_s": 20 },
    { "name": "ttyread", "short_desc": "Le /dev/tty", "activation": "echo READY_TO_READ; read x </dev/tty; echo GOT=$x" },
    { "name": "noargs", "short_desc": "Sem args", "activation": "echo NOARGS_RAN" }
  ]
}}
close $f

set failures 0
set testnum 0

# O \n inicial é necessário: o redraw do shell termina em '\r' sem newline, e
# sem ele o resultado do teste sai colado na linha repintada.
proc ok {name} {
    global testnum
    incr testnum
    puts "\n  \[PASS\] $name"
}
proc fail {name why} {
    global failures testnum
    incr testnum
    incr failures
    puts "\n  \[FAIL\] $name -- $why"
}

# Espera um padrão; reporta pass/fail sem abortar o resto da suíte.
proc want {name pat} {
    expect {
        -re $pat { ok $name }
        timeout  { fail $name "timeout esperando: $pat" }
        eof      { fail $name "eof inesperado esperando: $pat" }
    }
}

# Pausa obrigatória depois de todo comando que executa um shell command.
# Durante a execução o terminal volta ao modo cooked; ao terminar, o
# TerminalRestorer repõe o raw mode com TCSAFLUSH, que DESCARTA a entrada
# pendente. Sem esta pausa o send() seguinte é digitado dentro dessa janela e
# some silenciosamente. Não dá para sincronizar pelo prompt: ele é repintado
# a cada ~110ms, então casaria na hora e não provaria nada.
proc settle {} { sleep 1.0 }

puts "== aethercli: testes do loop interativo =="

spawn $BIN -C $CONF
want "motd exibido"            {TEST-MOTD-OK}
want "prompt inicial"          {aethercli# }
settle

# --- Completar com TAB -----------------------------------------------------
# "sh" + TAB -> unico match ("show"), completa e adiciona espaco.
send "sh\t"
want "tab completa prefixo unico" {show }

send "\025"  ;# Ctrl+U limpa a linha

# --- Duplo TAB lista opcoes ------------------------------------------------
# "s" casa show e set: duplo TAB deve listar os dois.
send "s\t\t"
want "duplo tab lista 'show'" {show}
want "duplo tab lista 'set'"  {set}

send "\025"

# --- '?' mostra ajuda contextual -------------------------------------------
send "show ?"
want "'?' lista subcomando version" {version}

send "\025"

# --- Comando que le o terminal ----------------------------------------------
# Com timeout_s o filho tem grupo proprio, que precisa ser o foreground do tty;
# em background, o read trava.
# Sincroniza pela saída do filho: dormir aqui não drena o PTY, o shell bloqueia
# no repaint e o abc seria descartado pelo TCSAFLUSH do TerminalRestorer.
send "readtty\r"
want "filho iniciou" {READY_TO_READ}
send "abc\r"
want "filho le o terminal em foreground" {GOT=abc}
settle
send "noargs\r"
want "shell retoma o terminal depois do filho" {NOARGS_RAN}
settle

# --- Comando que le /dev/tty com stdin redirecionado --------------------------
# sudo e ssh pedem senha assim; fora do foreground o filho pararia para sempre.
spawn sh -c "$BIN -C $CONF -p ttyread </dev/null"
want "filho le /dev/tty com stdin redirecionado (inicio)" {READY_TO_READ}
send "xyz\r"
want "filho le /dev/tty com stdin redirecionado" {GOT=xyz}
expect eof
wait
spawn $BIN -C $CONF
want "prompt apos ttyread" {aethercli# }
settle

# --- Comando ambiguo -------------------------------------------------------
# "r" casa run e rm.
send "r\r"
want "comando ambiguo detectado" {Ambiguous command}

# --- Entrada invalida com marcador ^ ---------------------------------------
send "naoexiste\r"
want "entrada invalida marca com ^" {Invalid input detected}

# --- Execucao de comando ---------------------------------------------------
send "show version\r"
want "comando executa activation" {VERSION_RAN}
settle

# --- Abreviacao estilo Cisco -----------------------------------------------
send "sh ver\r"
want "abreviacao 'sh ver' resolve" {VERSION_RAN}
settle

# --- Comando incompleto ----------------------------------------------------
send "show\r"
want "comando incompleto avisa" {Incomplete command}

# --- Politica de argumentos ------------------------------------------------
send "noargs extra\r"
want "comando sem args recusa argumento" {does not accept arguments}

# --- Bloqueio de injecao de flag -------------------------------------------
send "show files -rf\r"
want "argumento com '-' bloqueado" {Security violation}

# --- args: append repassa argumento ----------------------------------------
send "show files /tmp\r"
want "args append executa" {FILES_RAN}
settle

# --- Historico (seta pra cima) ---------------------------------------------
send "\033\[A"
want "seta cima traz ultimo comando" {show files /tmp}
send "\025"

# --- Ctrl+C limpa a linha, nao mata a shell --------------------------------
send "lixo"
send "\003"
want "ctrl+c ecoa ^C" {\^C}
send "show version\r"
want "shell sobrevive ao ctrl+c" {VERSION_RAN}
settle

# --- Ctrl+C interrompe comando em execucao ----------------------------------
send "longtask\r"
expect "executing"
sleep 0.3
send "\003"
want "ctrl+c interrompe comando filho em execucao" {terminated by signal}
settle

# --- Parametros tipados e enum TAB completion (PAR-2 e PAR-3) --------------
send "service ng\t"
want "tab completa valor do enum" {nginx }
send "\r"
want "executa com parametro tipado" {SERVICE_OK}
settle

# --- Ajuda '?' para comando com parametros (PAR-3) -------------------------
send "service ?"
want "'?' lista informacoes de parametro" {Target service}
send "\025"


# --- Edicao UTF-8: backspace apaga o acento inteiro ------------------------
# "ção" + 1 backspace deve sobrar "çã" (e nao meio byte de 'o').
send "ção\177"
want "backspace remove codepoint UTF-8 inteiro" {ção}
send "\025"

# --- exit encerra ----------------------------------------------------------
send "exit\r"
want "exit encerra a shell" {Exiting}
expect eof

# --- Fluxo de login (require_authentication) -------------------------------
puts "-- login --"
set ACONF "$SANDBOX/auth.json"
set f [open $ACONF w]
puts $f {{
  "motd": "AUTH-MOTD-OK",
  "require_authentication": "true",
  "number_auth_fail": 2,
  "commands": [
    { "name": "show", "subcommands": [
        { "name": "version", "short_desc": "Versao", "activation": "echo VERSION_RAN" } ] }
  ]
}}
close $f

# Provisiona o usuario via --adduser (cria users.json do zero).
spawn $BIN -C $ACONF --adduser operador
expect "New password: "
send "senha12345\r"
expect "Retype password: "
send "senha12345\r"
want "adduser cria usuario" {Added user 'operador'}
expect eof

# Senha errada e depois certa.
spawn $BIN -C $ACONF
want "login pede usuario"    {Username: }
send "operador\r"
want "login pede senha"      {Password: }
send "senhaerrada\r"
want "senha errada rejeitada" {cannot log you in}

want "login repergunta usuario" {Username: }
send "operador\r"
expect "Password: "
send "senha12345\r"
want "login correto entra na shell" {AUTH-MOTD-OK}
settle
send "show version\r"
want "comando roda apos login" {VERSION_RAN}
settle
send "exit\r"
expect eof

# Estouro do numero de tentativas encerra o processo (fail closed).
spawn $BIN -C $ACONF
expect "Username: "
send "operador\r"
expect "Password: "
send "errada1\r"
expect "cannot log you in"
expect "Username: "
send "operador\r"
expect "Password: "
send "errada2\r"
want "estouro de tentativas encerra" {too many failed login attempts}
expect eof

# --- Arvore padrao: reload fica dentro de configure --------------------------
set DEFAULT_CONF [file normalize [file join [file dirname [info script]] .. etc config.json]]
spawn $BIN -C $DEFAULT_CONF
want "prompt da arvore padrao" {aethercli# }
settle
send "reload\r"
want "reload fora de configure e invalido" {Invalid input}
settle
send "configure terminal\r"
want "entra em configure" {config\)# }
settle
send "reload\r"
want "reload dentro de configure" {Reloading}
want "prompt apos reload" {aethercli# }
send "\004"
expect eof

# Reload dentro de macro nao pode deixar a sessao gravando no log da macro.
set f [open "$SANDBOX/rl.macro" w]
puts $f "configure terminal reload"
close $f
set RCONF "$SANDBOX/reload.json"
set f [open $RCONF w]
puts $f {{ "commands": [
  { "name": "macro", "subcommands": [ { "name": "run", "activation": "internal:run_macro", "args": "append" } ] },
  { "name": "marker", "activation": "echo AFTER_RELOAD_MARK" },
  { "name": "configure", "subcommands": [ { "name": "terminal", "activation": "internal:config_mode", "subcommands": [
    { "name": "reload", "activation": "internal:reload" } ] } ] }
] }}
close $f
spawn $BIN -C $RCONF
want "prompt antes da macro" {aethercli# }
settle
send "macro run rl.macro\r"
want "macro recarrega" {Reloading}
settle
send "marker\r"
want "saida apos reload volta ao terminal" {AFTER_RELOAD_MARK}
settle
send "\004"
expect eof

# --- Resultado -------------------------------------------------------------
file delete -force $SANDBOX
puts ""
if {$failures == 0} {
    puts "Todos os $testnum testes interativos passaram."
    exit 0
}
puts "$failures de $testnum testes interativos FALHARAM."
exit 1
