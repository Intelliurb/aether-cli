{
  "motd": "Welcome to AetherCLI - Advanced Management Shell\nType '?' or double-tab for help.\n",
  "scripts_dir": "scripts",
  "commands": [
    {
      "name": "system",
      "short_desc": "Recursos e informações do sistema",
      "subcommands": [
        {
          "name": "disk",
          "short_desc": "Uso dos sistemas de arquivos",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/system-disk.sh",
          "syntax": "system disk",
          "mcp": false
        },
        {
          "name": "memory",
          "short_desc": "Uso de memória",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/system-memory.sh",
          "syntax": "system memory",
          "mcp": false
        },
        {
          "name": "cpu",
          "short_desc": "Uso de CPU",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/system-cpu.sh",
          "syntax": "system cpu",
          "mcp": false
        },
        {
          "name": "version",
          "short_desc": "Versão do sistema",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/system-version.sh",
          "syntax": "system version",
          "mcp": false
        },
        {
          "name": "time",
          "short_desc": "Mostrar a hora (atualizado)",
          "activation": "date",
          "syntax": "system time",
          "mcp": false
        }
      ],
      "mcp": false
    },
    {
      "name": "network",
      "short_desc": "Informações de rede",
      "subcommands": [
        {
          "name": "interface",
          "short_desc": "Endereços IPv4 e máscaras das interfaces",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/network-interface.sh",
          "syntax": "network interface",
          "subcommands": [
            {
              "name": "statistics",
              "short_desc": "Estatísticas de tráfego das interfaces",
              "activation": "${AETHERCLI_SCRIPTS_DIR}/network-interface-statistics.sh",
              "syntax": "network interface statistics",
              "mcp": false
            }
          ],
          "mcp": false
        },
        {
          "name": "route",
          "short_desc": "Tabela de roteamento",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/network-route.sh",
          "syntax": "network route",
          "mcp": false
        },
        {
          "name": "listening",
          "short_desc": "Portas TCP e UDP em escuta",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/network-listening.sh",
          "syntax": "network listening",
          "mcp": false
        }
      ],
      "mcp": false
    },
    {
      "name": "file",
      "short_desc": "Arquivos",
      "subcommands": [
        {
          "name": "list",
          "short_desc": "Listar arquivos",
          "activation": "ls -la",
          "syntax": "file list [path]",
          "args": "append",
          "mcp": false
        },
        {
          "name": "find",
          "short_desc": "Localizar arquivos por padrão",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/file-find.sh",
          "syntax": "file find <pattern> [directory]",
          "args": "append",
          "mcp": false
        }
      ],
      "mcp": false
    },
    {
      "name": "macro",
      "short_desc": "Macros",
      "subcommands": [
        {
          "name": "run",
          "short_desc": "Executar arquivo .macro",
          "activation": "internal:run_macro",
          "syntax": "macro run <arquivo.macro>",
          "args": "append",
          "mcp": false
        }
      ],
      "mcp": false
    },
    {
      "name": "settings",
      "short_desc": "Configuração em uso",
      "subcommands": [
        {
          "name": "show",
          "short_desc": "Exibe a configuração do app",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/settings-show.sh",
          "syntax": "settings show",
          "mcp": false
        },
        {
          "name": "tree",
          "short_desc": "Exibe a árvore de comandos",
          "activation": "${AETHERCLI_SCRIPTS_DIR}/settings-tree.sh",
          "syntax": "settings tree",
          "mcp": false
        }
      ],
      "mcp": false
    },
    {
      "name": "configure",
      "abbrev": "conf",
      "short_desc": "Entrar no modo de configuração",
      "subcommands": [
        {
          "name": "terminal",
          "short_desc": "Configurar via terminal",
          "activation": "internal:config_mode",
          "syntax": "configure terminal",
          "subcommands": [
            {
              "name": "list",
              "short_desc": "Listagens do engine",
              "subcommands": [
                {
                  "name": "macros",
                  "short_desc": "Listar arquivos .macro disponíveis",
                  "activation": "internal:list_macros",
                  "syntax": "list macros",
                  "mcp": false
                },
                {
                  "name": "users",
                  "short_desc": "Listar usuários configurados",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-list-users.sh",
                  "syntax": "list users",
                  "mcp": false
                },
                {
                  "name": "commands",
                  "short_desc": "Listar comandos dinâmicos",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-list-commands.sh",
                  "syntax": "list commands",
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "add",
              "short_desc": "Adicionar recursos",
              "subcommands": [
                {
                  "name": "user",
                  "short_desc": "Adicionar um novo usuário",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-add-user.sh",
                  "syntax": "add user <username>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                },
                {
                  "name": "command",
                  "short_desc": "Adicionar um comando ao menu",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-add-command.sh",
                  "syntax": "add command <parent_path> <name> <short_desc> [activation] [syntax]",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "rm",
              "short_desc": "Remover recursos",
              "subcommands": [
                {
                  "name": "user",
                  "short_desc": "Remover um usuário",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-rm-user.sh",
                  "syntax": "rm user <username>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                },
                {
                  "name": "command",
                  "short_desc": "Remover um comando do menu",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-rm-command.sh",
                  "syntax": "rm command <command_path>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "set",
              "short_desc": "Definir configurações",
              "subcommands": [
                {
                  "name": "statusbar",
                  "short_desc": "Ativar ou desativar a status bar",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-set-statusbar.sh",
                  "syntax": "set statusbar <on|off>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                },
                {
                  "name": "language",
                  "short_desc": "Definir idioma (english-us|portuguese-brasil)",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-set-language.sh",
                  "syntax": "set language <english-us|portuguese-brasil>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                },
                {
                  "name": "authentication",
                  "short_desc": "Ativar ou desativar exigência de login local",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-set-authentication.sh",
                  "syntax": "set authentication <on|off>",
                  "args": "append",
                  "admin_only": true,
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "passwd",
              "short_desc": "Alterar senhas",
              "subcommands": [
                {
                  "name": "user",
                  "short_desc": "Alterar senha de um usuário existente",
                  "activation": "${AETHERCLI_SCRIPTS_DIR}/configure-terminal-passwd-user.sh",
                  "syntax": "passwd user <username>",
                  "args": "append",
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "show",
              "short_desc": "Exibir informacoes do modo de configuracao",
              "subcommands": [
                {
                  "name": "whoami",
                  "short_desc": "Exibe o usuario atual",
                  "activation": "echo $AETHERCLI_USER",
                  "syntax": "show whoami",
                  "mcp": false
                }
              ],
              "mcp": false
            },
            {
              "name": "reload",
              "short_desc": "Recarrega o arquivo de configuração e o idioma na memória",
              "activation": "internal:reload",
              "syntax": "reload",
              "mcp": false
            }
          ],
          "mcp": false
        }
      ],
      "mcp": false
    }
  ]
}
